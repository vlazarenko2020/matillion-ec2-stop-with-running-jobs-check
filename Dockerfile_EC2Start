FROM public.ecr.aws/lambda/python:3.11

# Copy requirements.txt
COPY requirements.txt ${LAMBDA_TASK_ROOT}

# Copy function code
COPY lambda_function_EC2Start.py ${LAMBDA_TASK_ROOT}/lambda_function.py

COPY Modules_common/*.py ${LAMBDA_TASK_ROOT}/Modules_common/

COPY Modules_start/*.py ${LAMBDA_TASK_ROOT}/Modules_start/

RUN ls ${LAMBDA_TASK_ROOT}

RUN ls ${LAMBDA_TASK_ROOT}/Modules_common

RUN ls ${LAMBDA_TASK_ROOT}/Modules_start

# Install the specified packages
RUN pip install -r requirements.txt

RUN pip list

# Set the CMD to your handler (could also be done as a parameter override outside of the Dockerfile)
CMD [ "lambda_function.lambda_handler" ]
