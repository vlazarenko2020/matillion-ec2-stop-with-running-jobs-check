# Copy to project.env (git-ignored), fill in real values, then run:  . ./project.env
# On Lambda, set the same variables in the function configuration instead.
export MATILLION_S3_BUCKET="your-bucket-name"
export MATILLION_EMAIL_SENDER="Matillion <sender@example.com>"   # must be verified in Amazon SES
export MATILLION_ADMIN_EMAIL="admin@example.com"                 # Stop Lambda: gets the "already stopped" email
export MATILLION_EMAIL_ALWAYS_CC="admin@example.com"             # optional: copied on every email
